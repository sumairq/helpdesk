{
  "name": "server",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node --import tsx src/index.ts",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "seed": "tsx src/seed.ts",
    "seed:tickets": "tsx src/seed-tickets.ts",
    "start:test": "dotenv -e .env.test -- tsx src/index.ts",
    "db:migrate:test": "dotenv -e .env.test -- prisma migrate deploy",
    "db:reset:test": "dotenv -e .env.test -- prisma migrate reset --force",
    "db:push:test": "dotenv -e .env.test -- prisma db push",
    "seed:test": "dotenv -e .env.test -- tsx src/seed.ts",
    "reset:test": "dotenv -e .env.test -- tsx src/reset.ts",
    "seed-agent:test": "dotenv -e .env.test -- tsx src/seed-agent.ts",
    "seed:ai-agent": "tsx src/seed-ai-agent.ts"
  },
  "dependencies": {
    "@ai-sdk/openai": "^3.0.54",
    "@helpdesk/core": "*",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "ai": "^6.0.169",
    "better-auth": "^1.6.9",
    "cors": "^2.8.5",
    "dompurify": "^3.4.1",
    "dotenv": "^17.4.2",
    "express": "^4.21.1",
    "jsdom": "^29.1.0",
    "pg-boss": "^12.18.1"
  },
  "devDependencies": {
    "@better-auth/cli": "^1.4.21",
    "@types/cors": "^2.8.17",
    "@types/dompurify": "^3.0.5",
    "@types/express": "^5.0.0",
    "@types/jsdom": "^28.0.1",
    "@types/node": "^22.9.0",
    "dotenv-cli": "^11.0.0",
    "prisma": "^7.8.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}
